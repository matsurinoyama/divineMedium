# Gemini serves both the entity and the transcription
GEMINI_API_KEY=your_gemini_key_here

# Optional: pin an exact model id instead of the floating alias
# GEMINI_MODEL=gemini-flash-latest

# Optional: force one language for presentations (en / ja)
# LANGUAGE_OVERRIDE=ja

# Optional: a single line left on the panel between sessions (blank = blank panel)
# IDLE_TEXT=祈りなさい

# Optional: render to screen.png instead of the panel (for development off-Pi)
# EPAPER_MOCK=1

# Optional: sounddevice input index for the microphone (blank = system default)
# SPEECH_INPUT=1

# Optional: another font face for the panel
# FONT_PATH=fonts/FOT-ShinGyoReiStdN-R.otf

# Smart plugs — kept for later, not used by main.py (see plugs.py)
# TPLINK_HOST-1=000.000.0.000
# TPLINK_HOST-2=000.000.0.000
# TPLINK_USERNAME=your_tplink_username
# TPLINK_PASSWORD=your_tplink_password
