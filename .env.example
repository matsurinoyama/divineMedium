# Copy to .env. One file serves both vessels: the Pi (main.py) and the Mac
# (echo_server/server.py) each read the .env at the root of the project.

# The Entity's mind and voice — required
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=            # one account for the Pi and the Mac, so the borrowed voice is seen by both

# The Entity
# ENTITY_MODEL=claude-haiku-5-5      # the mind that speaks as the Entity
# LANGUAGE_OVERRIDE=en               # the tongue the covenant opens in (default ja)

# The panel
# EPAPER_MOCK=1                      # draw to screen.png instead of the panel
# ROTATE=180                         # the panel hangs upside down; 0 sets it upright
# VERTICAL=auto                      # auto / always / never: Japanese set in columns
# FONT_PATH=assets/fonts/…           # the brush face
# LATIN_FONT_PATH=…                  # another face for latin, if wished

# Sound on the Pi (sounddevice index or name; unset: the system default)
# SPEECH_INPUT=1                     # the microphone
# MAIN_OUTPUT=0                      # the voice and the bells

# The room: Tapo plugs (unset: the room is left as it is)
# TPLINK_FAN=172.27.56.184
# TPLINK_LIGHT=172.27.56.185
# TPLINK_USERNAME=…
# TPLINK_PASSWORD='…'                # quote it

# The echo (unset ECHO_HOST: the Entity speaks without its echo)
# ECHO_HOST=mymac.local:8765         # where the Pi finds the Mac
# ECHO_OUTPUTS=5:0:4,5:1:4,5:2:4,5:3:4   # the Mac's speakers, device:channel:channels
# ECHO_PORT=8765
# ECHO_MODEL=claude-haiku-5-5
# ECHO_PEAK=0.3                      # every echo is brought to this level
# CAVE_VOLUME=1.0                    # the cave beneath the echoes; 0 for silence
# CAVE_FILE=assets/CAVESOUNDS.mp3
